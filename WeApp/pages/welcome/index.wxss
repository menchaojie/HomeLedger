.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 40rpx 40rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
  color: white;
}

.welcome-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.app-slogan {
  font-size: 28rpx;
  opacity: 0.9;
}

.welcome-content {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.feature-list {
  display: flex;
  justify-content: space-around;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.feature-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  color: white;
}

.feature-text {
  font-size: 24rpx;
  text-align: center;
  opacity: 0.9;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.van-button {
  border-radius: 25rpx !important;
  font-size: 32rpx !important;
  height: 100rpx !important;
}

.van-notice-bar {
  margin-top: 40rpx;
  background: rgba(255,255,255,0.1) !important;
  color: white !important;
  border-radius: 10rpx;
}
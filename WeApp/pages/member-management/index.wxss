/* pages/member-management/index.wxss */

.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 20rpx 0;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.form-section {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  background-color: #fafafa;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 15rpx;
}

.member-selector {
  border: 1rpx solid #d9d9d9;
  border-radius: 4rpx;
  padding: 15rpx;
  background-color: #fff;
}

.role-picker {
  border: 1rpx solid #d9d9d9;
  border-radius: 4rpx;
  padding: 15rpx;
  background-color: #fff;
}

.role-display {
  font-size: 28rpx;
  color: #333;
  padding: 15rpx;
  background-color: #fff;
  border: 1rpx solid #d9d9d9;
  border-radius: 4rpx;
}

.picker-view {
  font-size: 28rpx;
  color: #333;
}

.form-button {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}

.submit-button {
  width: 100%;
  height: 80rpx;
  background-color: #4CAF50;
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 10rpx;
  border: none;
}

.back-button {
  text-align: center;
  margin-top: 20rpx;
}

.back-btn {
  width: 100%;
  height: 70rpx;
  background-color: #f0f0f0;
  color: #333;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d9d9d9;
}

/* 提交中状态 */
.submit-button[disabled] {
  background-color: #95d499;
  opacity: 0.8;
}
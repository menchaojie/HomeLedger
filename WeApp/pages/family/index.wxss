/* 家庭页面样式 */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 家庭信息区 */
.family-info {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.family-header {
  display: flex;
  align-items: center;
}

.family-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.family-details {
  flex: 1;
}

.family-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
  display: block;
}

.family-id-section {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.family-id {
  font-size: 24rpx;
  color: #666666;
  margin-right: 16rpx;
}

.copy-btn {
  background-color: #bfbfb5;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

.copy-btn:active {
  background-color: #1677d9;
  transform: scale(0.95);
}

.copy-text {
  font-size: 20rpx;
  color: #289259;
  font-weight: 500;
  line-height: 1;
}

.family-meta {
  font-size: 20rpx;
  color: #999999;
  display: block;
}

/* 成员列表 */
.member-list {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.members {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: 8rpx;
  background-color: #f9f9f9;
}

.member-item:active {
  background-color: #f0f0f0;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 4rpx;
}

.member-role {
  font-size: 20rpx;
  color: #666666;
}

.member-balance {
  font-size: 24rpx;
  font-weight: bold;
  color: #4CAF50;
}

/* 操作区 */
.action-area {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.admin-actions {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.van-button {
  margin-bottom: 12rpx;
}

.van-cell {
  font-size: 25rpx !important;
  /* background-color:#1677d9 !important ; */
  height: 60rpx;
  width: 100rpx;
}

/* 管理员下拉框样式 */
.admin-dropdown {
  margin-top: 16rpx;
}

.dropdown-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  border: 1rpx solid #e0e0e0;
}

.dropdown-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}

.dropdown-arrow {
  font-size: 24rpx;
  color: #666666;
  transition: transform 0.3s ease;
}

.dropdown-arrow.open {
  transform: rotate(180deg);
}

.dropdown-content {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.non-admin-message {
  /* margin-top: 16rpx; */
  padding: 24rpx;
  /* background-color: #f5f5f5; */
  border-radius: 8rpx;
  /* border: 1rpx solid #e0e0e0; */
  text-align: center;
}

.message-text {
  font-size: 24rpx;
  color: #999999;
}


.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  position: sticky;
  top: 0;
  z-index: 100;
}

.content {
  padding: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.message-icon {
  margin-right: 16rpx;
}

.icon-circle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: #E3F2FD;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  font-size: 20rpx;
  color: #2196F3;
  font-weight: bold;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.message-body {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
  line-height: 1.4;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  display: block;
}

.message-status {
  margin-left: 12rpx;
}

.unread-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: #FF4444;
  margin-top: 8rpx;
}

.empty-message {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 24rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.message-item:active {
  background-color: #f9f9f9;
}
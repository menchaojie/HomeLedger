.container {
  padding: 0;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  height: 88rpx;
  background-color: #4CAF50;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  text-align: center;
}

.form-section {
  padding: 30rpx 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  color: #333;
  padding: 0 10rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 5rpx;
  background-color: #f9f9f9;
  box-sizing: border-box;
}

.form-button {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
}

.submit-button {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 10rpx;
}

.back-button {
  margin-top: 20rpx;
}

.back-btn {
  width: 100%;
  height: 80rpx;
  font-size: 28rpx;
  background-color: white;
  color: #666;
  border: 1rpx solid #e8e8e8;
  border-radius: 10rpx;
}

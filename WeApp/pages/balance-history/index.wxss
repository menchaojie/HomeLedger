.container {
  padding: 0;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background-color: #4CAF50;
  padding: 0 30rpx;
  position: fixed;
  /* top: 0;
  left: 0;
  right: 0; */
  /* z-index: 100; */
  /* width: 100%; */
}

.header-left {
  width: 80rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: white;
  flex: 1;
  text-align: center;
  width: 100%;
}

.header-right {
  width: 80rpx;
}

.filter-container {
  margin-top: 100rpx;
  padding: 0 20rpx;
}

.date-row {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.date-section {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 15rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 5rpx;
  background-color: #f9f9f9;
}

.date-separator {
  margin: 0 20rpx;
  font-size: 28rpx;
  color: #666;
}

.date-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 5rpx;
}

.date-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

.date-item van-icon {
  margin-left: 10rpx;
}

.filter-buttons {
  margin-top: 20rpx;
  display: flex;
  gap: 15rpx;
}

.filter-btn {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  border: none;
  border-radius: 8rpx;
  line-height: 80rpx;
}

.filter-btn.primary {
  background-color: #3daf08;
  color: white;
}

.filter-btn.reset {
  background-color: #f0f0f0;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.transaction-list {
  padding: 0 20rpx;
  margin-top: 20rpx;
  margin-bottom: 40rpx;
}

.transaction-list-content {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #999;
}

.transaction-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.transaction-item:last-child {
  border-bottom: none;
}

.transaction-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.transaction-description {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.transaction-amount {
  font-size: 32rpx;
  font-weight: bold;
  min-width: 150rpx;
  text-align: right;
}

.transaction-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 40rpx;
}

.transaction-status {
  font-size: 24rpx;
  color: #999;
  min-width: 100rpx;
}

.transaction-date {
  font-size: 24rpx;
  color: #999;
  min-width: 200rpx;
  text-align: right;
}

.date-picker-popup {
  padding: 20rpx;
  background-color: white;
}

.date-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.date-picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

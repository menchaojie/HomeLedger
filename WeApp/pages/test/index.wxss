/* pages/test/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 20rpx;
}

.method-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  display: block;
  margin-bottom: 20rpx;
}

.custom-input-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.input-label {
  font-size: 28rpx;
  color: #333;
  width: 150rpx;
}

.date-input {
  flex: 1;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  background-color: #fafafa;
}

.date-input:focus {
  border-color: #1989fa;
  background-color: white;
}

.quick-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  justify-content: space-between;
}

.quick-btn {
  flex: 1;
  min-width: 150rpx;
  background-color: #f0f0f0;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 10rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.quick-btn.active {
  background-color: #1989fa;
  color: white;
}

.quick-btn:not(.active):active {
  background-color: #e0e0e0;
}

.result-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  text-align: center;
}

.result-title {
  font-size: 28rpx;
  color: white;
  font-weight: 600;
  display: block;
  margin-bottom: 15rpx;
}

.result-text {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
  display: block;
}
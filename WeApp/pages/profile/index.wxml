<view class="container">
  <!-- 已登录状态 -->
  <view class="user-content">
    <!-- 个人信息区 -->
    <view class="personal-info">
      <view class="section-title">个人信息</view>
      <view class="info-content">
        <image class="user-avatar" src="{{user.avatar}}" mode="aspectFill"></image>
        <view class="user-details">
          <text class="user-name">用户名: {{user.user_name || '未设置'}}</text>
          <text class="user-info">昵称: {{user.nickname}}</text>
          <text class="user-message">留言: {{user.message}}</text>
          <text class="user-info">角色: {{user.role || '未设置'}}</text>
          <text class="user-info">手机: {{user.phone || '未设置'}}</text>
          <text class="user-info">邮箱: {{user.email || '未设置'}}</text>
          <button bindtap="onEditProfile" type="default"  >编辑资料</button>
        </view>
      </view>
    </view>

    <!-- 个人余额区 -->
    <view class="balance-area">
      <view class="section-title">个人余额</view>
      <view class="balance-content">
        <text class="balance-amount">可自由支配余额: {{user.balance}} 元</text>
        <view class="balance-management">
          <button bindtap="onExpenseRecord" type="default" inline >个人支出记账</button>
          <button bindtap="onBalanceHistory"  type="default" inline>余额变动记录</button>
        </view>
      </view>
    </view>

    <!-- 奖励申请区 -->
    <view class="reward-area">
      <view class="section-title">奖励申请</view>
      <view class="reward-content">
        <button bindtap="onSubmitReward" 
        style="width:100%"
        plain type="primary" block>提交奖励申请</button>
        <!-- <view wx:if="{{currentUser.role === 'admin'}}">
          <van-button bindtap="onRewardApproval" type="warning" block>奖励审批</van-button>
        </view> -->
      </view>
    </view>

    <!-- 设置区 -->
    <view class="settings-area">
      <view class="section-title">更多操作</view>
      <view class="settings-list">
        <!-- 阅读信息 -->
        <view class="settings-group">
          <view class="group-header" bindtap="toggleGroup" data-group="message">
            <view class="group-title">阅读信息</view>
            <van-icon name="{{groupStates.message ? 'arrow-down' : 'arrow'}}" class="group-arrow" />
          </view>
          <view class="group-content" wx:if="{{groupStates.message}}">
            <view class="settings-item" bindtap="onMessageCenter">
              <view class="item-left">
                <van-icon name="chat-o" class="item-icon" />
                <text class="item-text">消息中心</text>
                <view wx:if="{{unreadMessageCount > 0}}" class="badge">{{unreadMessageCount}}</view>
              </view>
              <view class="item-right">
                <text class="item-value">请点击查看详情</text>
                <van-icon name="arrow" class="item-arrow" />
              </view>
            </view>

          </view>
        </view>
        
        <!-- 应用设置 -->
        <view class="settings-group">
          <view class="group-header" bindtap="toggleGroup" data-group="app">
            <view class="group-title">应用设置</view>
            <van-icon name="{{groupStates.app ? 'arrow-down' : 'arrow'}}" class="group-arrow" />
          </view>
          <view class="group-content" wx:if="{{groupStates.app}}">
            <view class="settings-item" bindtap="onNotificationSettings">
              <view class="item-left">
                <van-icon name="bell-o" class="item-icon" />
                <text class="item-text">通知设置</text>
              </view>
              <view class="item-right">
                <text class="item-value">开发中</text>
                <van-icon name="arrow" class="item-arrow" />
              </view>
            </view>
            
            <view class="settings-item" bindtap="onSystemSettings">
              <view class="item-left">
                <van-icon name="setting-o" class="item-icon" />
                <text class="item-text">系统设置</text>
              </view>
              <view class="item-right">
                <text class="item-value">开发中</text>
                <van-icon name="arrow" class="item-arrow" />
              </view>
            </view>
            
            <view class="settings-item" bindtap="onAboutApp">
            <view class="item-left">
              <van-icon name="info-o" class="item-icon" />
              <text class="item-text">关于应用</text>
            </view>
            <view class="item-right">
               <text class="item-value">开发中</text>
              <van-icon name="arrow" class="item-arrow" />
            </view>
          </view>
          
          <view class="settings-item" bindtap="onChangePassword">
            <view class="item-left">
              <van-icon name="lock-o" class="item-icon" />
              <text class="item-text">修改密码</text>
            </view>
            <view class="item-right">
              <text class="item-value">点击后进入重置密码页面</text>
              <van-icon name="arrow" class="item-arrow" />
            </view>
          </view>
          </view>
        </view>
        
        <!-- 账户操作 -->
        <view class="settings-group">
          <view class="group-header" bindtap="toggleGroup" data-group="account">
            <view class="group-title">账户操作</view>
            <van-icon name="{{groupStates.account ? 'arrow-down' : 'arrow'}}" class="group-arrow" />
          </view>
          <view class="group-content" wx:if="{{groupStates.account}}">
            <view class="settings-item logout-item" bindtap="onLogout">
              <view class="item-left">
                <van-icon name="close" class="item-icon logout-icon" />
                <text class="item-text logout-text">退出登录</text>
              </view>
              <view class="item-right">
                <text class="item-value">点击后将退出当前用户</text>
                <van-icon name="arrow" class="item-arrow" />
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>